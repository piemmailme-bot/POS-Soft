# ========================================================
# NABKUL COOPERATIVE SOCIETY - SMART POS & QR STORE
# Supabase Database Connection Configuration
# ========================================================

# Your Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
# Example: https://xyzcompany.supabase.co
SUPABASE_URL=

# Your Supabase Anon Public Key or Service Role Key
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=

# Client-accessible Supabase variables (if client-direct access is needed)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local Server Port (standard is 3000)
PORT=3000

# Server-side HMAC session signing secret (auto-generated in memory if omitted)
SESSION_SECRET=

# Optional Developer Tab Email & Passcode override (if omitted, first-time setup is available in UI)
DEVELOPER_EMAIL=
DEVELOPER_PASSCODE=

# Optional Gemini API Key
GEMINI_API_KEY=
